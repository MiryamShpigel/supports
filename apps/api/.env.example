# Copy to .env (never commit .env). In TEST/PROD these come from the secret store.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:4200

DATABASE_URL=postgres://supports:supports_dev@localhost:5544/supports
DB_STATEMENT_TIMEOUT_MS=10000

QUERY_CACHE_TTL_SECONDS=300
RECORDS_PAGE_LIMIT=500

# AI provider for free-text questions: anthropic | rule-based
# Without ANTHROPIC_API_KEY the system falls back to the rule-based parser.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
