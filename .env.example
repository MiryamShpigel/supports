# Used by `docker compose up` (the whole system in containers). Copy to .env - never commit .env.
# Local development without containers reads apps/api/.env instead.
POSTGRES_PASSWORD=supports_dev
LOG_LEVEL=info


# AI provider for free-text questions: anthropic | gemini | openai | rule-based
AI_PROVIDER=rule-based
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
